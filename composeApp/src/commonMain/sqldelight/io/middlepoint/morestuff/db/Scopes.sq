import io.middlepoint.morestuff.shared.domain.model.Uuid;
import kotlin.Boolean;
import kotlin.Int;
import kotlinx.datetime.Instant;

CREATE TABLE scopes (
    id TEXT AS Uuid NOT NULL PRIMARY KEY,
    scope_name TEXT NOT NULL,
    scope_order INTEGER AS Int NOT NULL,
    created_at INTEGER AS Instant NOT NULL,
    updated_at INTEGER AS Instant NOT NULL,
    deleted INTEGER AS Boolean NOT NULL DEFAULT 0
);

selectAllUpdates:
SELECT *
FROM scopes
WHERE updated_at > ?;

createScope:
INSERT OR IGNORE INTO scopes
VALUES ?;

upsertScope:
INSERT INTO scopes
VALUES ?
ON CONFLICT(id) DO UPDATE
  SET scope_name  = excluded.scope_name,
      scope_order = excluded.scope_order,
      updated_at  = excluded.updated_at,
      deleted     = excluded.deleted
  WHERE excluded.updated_at > updated_at;

deleteScope:
UPDATE scopes
SET deleted = 1
WHERE id = :id;

selectScope:
SELECT scopes.*
FROM scopes
WHERE id = :id;

selectAllScopes:
SELECT scopes.*
FROM scopes
WHERE scopes.deleted = 0
ORDER BY scope_order ASC;

selectScopeByName:
SELECT *
FROM scopes
WHERE scope_name = :name;

updateScopeName:
UPDATE scopes
SET scope_name = :scopeName
WHERE id = :scopeId;

updateScopeOrder:
UPDATE scopes
SET scope_order = :scopeOrder
WHERE id = :scopeId;

countScopes:
SELECT COUNT(*)
FROM scopes
WHERE scopes.deleted = 0;

countScopesWithName:
SELECT COUNT(*)
FROM scopes
WHERE scopes.deleted = 0;

deleteAll:
DELETE FROM scopes;

-- Triggers

-- Only update the timestamp when other columns change
CREATE TRIGGER scopes_updated_at
AFTER UPDATE ON scopes
FOR EACH ROW
WHEN new.updated_at = old.updated_at
BEGIN
  UPDATE scopes
  SET updated_at = unixepoch('subsec') * 1000
  WHERE id = old.id;
END;


