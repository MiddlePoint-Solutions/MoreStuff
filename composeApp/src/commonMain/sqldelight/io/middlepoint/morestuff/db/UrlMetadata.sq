CREATE TABLE url_metadata (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    url TEXT NOT NULL,
    json_data TEXT NOT NULL,
    message_id INTEGER,
    FOREIGN KEY(message_id) REFERENCES message(id)
);


insertUrlMetadata:
INSERT INTO url_metadata(url, json_data, message_id)
VALUES (?, ?, ?);

getUrlMetadata:
SELECT *
FROM url_metadata
WHERE message_id = ?;