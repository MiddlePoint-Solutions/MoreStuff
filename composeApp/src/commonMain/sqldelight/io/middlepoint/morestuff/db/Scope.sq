import io.middlepoint.morestuff.shared.domain.model.Uuid;
import kotlin.Int;
import kotlinx.datetime.Instant;

CREATE TABLE scope (
    id TEXT AS Uuid NOT NULL PRIMARY KEY,
    scope_name TEXT UNIQUE NOT NULL,
    scope_order INTEGER AS Int NOT NULL,
    created_at INTEGER AS Instant NOT NULL,
    updated_at INTEGER AS Instant NOT NULL
);

createScope:
INSERT OR IGNORE INTO scope
VALUES ?;

deleteScope:
DELETE FROM scope
WHERE id = :id;

selectScope:
SELECT scope.*
FROM scope
WHERE id = :id;

selectAllScopes:
SELECT scope.*
FROM scope
ORDER BY scope_order ASC;

selectScopeByName:
SELECT *
FROM scope
WHERE scope_name = :name;

updateScopeName:
UPDATE scope
SET scope_name = :scopeName
WHERE id = :scopeId;

updateScopeOrder:
UPDATE scope
SET scope_order = :scopeOrder
WHERE id = :scopeId;

countScopes:
SELECT COUNT(*) FROM scope;

lastInsertRowId:
SELECT last_insert_rowid();

selectScopeById:
SELECT id, id, scope_name, scope_order
FROM scope
WHERE id = :id;