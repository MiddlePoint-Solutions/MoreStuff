import kotlin.Int;

CREATE TABLE scope (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    uuid TEXT NOT NULL,
    scope_name TEXT UNIQUE NOT NULL,
    scope_order INTEGER AS Int NOT NULL
);

createScope:
INSERT OR IGNORE INTO scope (uuid, scope_name, scope_order)
VALUES (:uid, :name, :order);

deleteScope:
DELETE FROM scope
WHERE id = :id;

selectScope:
SELECT scope.*
FROM scope
WHERE id = :id;

selectAllScopes:
SELECT scope.*
FROM scope
ORDER BY scope_order ASC;

selectScopeByName:
SELECT *
FROM scope
WHERE scope_name = :name;

updateScopeName:
UPDATE scope
SET scope_name = :scopeName
WHERE id = :scopeId;

updateScopeOrder:
UPDATE scope
SET scope_order = :scopeOrder
WHERE id = :scopeId;

countScopes:
SELECT COUNT(*) FROM scope;

lastInsertRowId:
SELECT last_insert_rowid();

selectScopeById:
SELECT id, uuid, scope_name, scope_order
FROM scope
WHERE id = :id;