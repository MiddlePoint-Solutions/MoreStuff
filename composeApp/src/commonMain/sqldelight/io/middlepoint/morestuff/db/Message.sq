import kotlin.Int;
import kotlinx.datetime.Instant;

CREATE TABLE message(
    id TEXT NOT NULL PRIMARY KEY,
    task_id TEXT NOT NULL,
    schedule_id INTEGER NOT NULL,
    created_at INTEGER AS Instant NOT NULL,
    updated_at INTEGER AS Instant NOT NULL,
    content_type INTEGER AS Int NOT NULL,
    content TEXT NOT NULL,
    reply_type INTEGER AS Int,
    reply_content TEXT,
    reply_time TEXT,
    FOREIGN KEY(task_id) REFERENCES tasks(id)
    );

selectAll:
SELECT *
FROM message
ORDER BY datetime(created_at) DESC;

selectMasterMessages:
SELECT message.*, url_metadata.json_data, message_data.data_id ,message_data.file_path,message_data.creation_time,message_data.data_type
FROM message
LEFT JOIN url_metadata ON message.id = url_metadata.message_id
LEFT JOIN message_data ON message.id = message_data.message_id
WHERE (content_type = 100 OR content_type = 101 OR (content_type = 200 AND reply_content IS NULL))
ORDER BY datetime(created_at) DESC;

selectMessageById:
SELECT message.*, url_metadata.json_data, message_data.data_id ,message_data.file_path,message_data.creation_time,message_data.data_type
FROM message
LEFT JOIN url_metadata ON message.id = url_metadata.message_id
LEFT JOIN message_data ON message.id = message_data.message_id
WHERE message.id = ?;


selectMessageByTaskId:
SELECT message.*, url_metadata.json_data, message_data.data_id ,message_data.file_path,message_data.creation_time,message_data.data_type
FROM message
LEFT JOIN url_metadata ON message.id = url_metadata.message_id
LEFT JOIN message_data ON message.id = message_data.message_id
WHERE task_id = ?
ORDER BY datetime(created_at) DESC;

selectTaskMessagesByContentType:
SELECT message.*, url_metadata.json_data, message_data.data_id ,message_data.file_path,message_data.creation_time,message_data.data_type
FROM message
LEFT JOIN url_metadata ON message.id = url_metadata.message_id
LEFT JOIN message_data ON message.id = message_data.message_id
WHERE message.task_id = ? AND message.content_type IN ?
ORDER BY datetime(message.created_at) DESC;

selectFirstTaskMessageWithType:
WITH LatestMessage AS (
    SELECT task_id, MAX(datetime(created_at)) AS latest_time
    FROM message
    WHERE content_type = ?
    GROUP BY task_id
)
SELECT m.*
FROM message AS m
JOIN LatestMessage AS lm ON m.task_id = lm.task_id AND datetime(m.created_at) = lm.latest_time
ORDER BY datetime(m.created_at) DESC;

selectTaskMessage:
SELECT message.id, url_metadata.json_data
FROM message
LEFT JOIN url_metadata ON message.id = url_metadata.message_id
WHERE task_id = ? AND content_type = ?
ORDER BY message.id DESC LIMIT 1;

selectLastTaskMessageByContentType:
SELECT * FROM message
WHERE content_type = ?
ORDER BY id DESC LIMIT 1;

insertMessage:
INSERT INTO message
VALUES ?;

updateTaskMessageReply:
UPDATE message
SET reply_type = ?, reply_content = ?, reply_time = ?
WHERE id = ?;

deleteActiveReminderMessages:
DELETE FROM message
WHERE content_type = 200 AND reply_time IS NULL;

countMessages:
SELECT count(*) FROM message;

countActiveReminderMessages:
SELECT count(*) FROM message
WHERE content_type = 200 AND reply_time IS NULL;

pageMessages:
SELECT *
FROM message
ORDER BY id DESC
LIMIT :limit OFFSET :offset;

lastInsertRowId:
SELECT last_insert_rowid();

deleteMessage:
DELETE FROM message
WHERE id = ?;

updateMessageContent:
UPDATE message
SET content = ?
WHERE id = ?;

