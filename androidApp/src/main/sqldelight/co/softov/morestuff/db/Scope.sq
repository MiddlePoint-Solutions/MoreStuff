CREATE TABLE scope (
    scope_id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    scope_uid TEXT NOT NULL,
    name TEXT NOT NULL,
    order_index INTEGER NOT NULL DEFAULT 0
);

createScope:
INSERT INTO scope (scope_uid, name)
VALUES (:scope_uid,:name);



deleteScope:
DELETE FROM scope
WHERE scope_id IN :scope_ids;

INSERT INTO scope (scope_id, scope_uid, name) VALUES (1, 'all-scope', 'All');


getScope:
SELECT scope_id, scope_uid, name
FROM scope;

updateScopeName:
UPDATE scope
SET name = :newName
WHERE scope_id = :scopeId;

updateScopeOrder:
UPDATE scope
SET order_index = :newOrderIndex
WHERE scope_id = :scopeId;
