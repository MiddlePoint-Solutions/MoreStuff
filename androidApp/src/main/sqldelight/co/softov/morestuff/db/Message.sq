import co.softov.morestuff.androidApp.domain.enums.ReplyType;

CREATE TABLE message(
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    task_id INTEGER NOT NULL,
    create_time TEXT NOT NULL,
    seen_time TEXT,
    content_type INTEGER AS Int NOT NULL,
    content TEXT NOT NULL,
    reply_type INTEGER as Int,
    reply_content TEXT,
    reply_time TEXT,
    FOREIGN KEY(task_id) REFERENCES task(id)
    );

selectAll:
SELECT *
FROM message
ORDER BY datetime(create_time);

selectMessageById:
SELECT *
FROM message
WHERE id = ?;

selectMessageByTaskId:
SELECT *
FROM message
WHERE task_id = ?;

selectCurrentTaskMessageId:
SELECT id
FROM message
WHERE task_id = ?
ORDER BY id DESC LIMIT 1;

insertMessage:
INSERT INTO message(task_id, create_time, content_type, content)
VALUES (?,?,?,?);

updateTaskMessageReply:
UPDATE message
SET reply_type = ?, reply_content = ?, reply_time = ?
WHERE id = ?;

countMessages:
SELECT count(*) FROM message;

pageMessages:
SELECT *
FROM message
ORDER BY id DESC
LIMIT :limit OFFSET :offset;

lastInsertRowId:
SELECT last_insert_rowid()
;