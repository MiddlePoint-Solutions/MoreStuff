CREATE TABLE message(
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    task_id INTEGER NOT NULL,
    schedule_id INTEGER NOT NULL,
    create_time TEXT NOT NULL,
    seen_time TEXT,
    content_type INTEGER AS Int NOT NULL,
    content TEXT NOT NULL,
    reply_type INTEGER AS Int,
    reply_content TEXT,
    reply_time TEXT,
    FOREIGN KEY(task_id) REFERENCES task(id)
    );

selectAll:
SELECT *
FROM message
ORDER BY datetime(create_time) DESC;

selectMasterMessages:
SELECT *
FROM message
WHERE (content_type = 100 OR content_type = 101 OR (content_type = 200 AND reply_content IS NULL))
ORDER BY datetime(create_time) DESC;

-- TODO: Distinct schedule messages? (i.e. remove past reminder message with same schedule id)
selectActiveReminderMessages:
SELECT *
FROM message
WHERE (content_type = 200 AND reply_time IS NULL);

selectMessageById:
SELECT *
FROM message
WHERE id = ?;

selectMessageByTaskId:
SELECT *
FROM message
WHERE task_id = ?
ORDER BY datetime(create_time) DESC;

selectTaskMessagesByContentType:
SELECT *
FROM message
WHERE task_id = ? AND content_type = ?
ORDER BY datetime(create_time) DESC;

selectCurrentTaskMessage:
SELECT *
FROM message
WHERE task_id = ?
ORDER BY id DESC LIMIT 1;

selectCurrentTaskMessageId:
SELECT id
FROM message
WHERE task_id = ?
ORDER BY id DESC LIMIT 1;

insertMessage:
INSERT INTO message(task_id, schedule_id, create_time, content_type, content)
VALUES (?,?,?,?,?);

updateTaskMessageReply:
UPDATE message
SET reply_type = ?, reply_content = ?, reply_time = ?
WHERE id = ?;

deleteActiveReminderMessages:
DELETE FROM message
WHERE content_type = 200 AND reply_time IS NULL;

countMessages:
SELECT count(*) FROM message;

countActiveReminderMessages:
SELECT count(*) FROM message
WHERE content_type = 200 AND reply_time IS NULL;

pageMessages:
SELECT *
FROM message
ORDER BY id DESC
LIMIT :limit OFFSET :offset;

lastInsertRowId:
SELECT last_insert_rowid()
;