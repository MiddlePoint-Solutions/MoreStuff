import kotlin.Int;

CREATE TABLE message(
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    task_id INTEGER NOT NULL,
    schedule_id INTEGER NOT NULL,
    create_time TEXT NOT NULL,
    seen_time TEXT,
    content_type INTEGER AS Int NOT NULL,
    content TEXT NOT NULL,
    reply_type INTEGER AS Int,
    reply_content TEXT,
    reply_time TEXT,
    FOREIGN KEY(task_id) REFERENCES task(id)
    );

selectAll:
SELECT *
FROM message
ORDER BY datetime(create_time) DESC;

selectMasterMessages:
SELECT message.*, url_metadata.json_data, message_data.data_id ,message_data.file_path,message_data.creation_time,message_data.data_type
FROM message
LEFT JOIN url_metadata ON message.id = url_metadata.message_id
LEFT JOIN message_data ON message.id = message_data.message_id
WHERE (content_type = 100 OR content_type = 101 OR (content_type = 200 AND reply_content IS NULL))
ORDER BY datetime(create_time) DESC;

-- TODO: Distinct schedule messages? (i.e. remove past reminder message with same schedule id)
selectActiveReminderMessages:
SELECT message.*
FROM message
WHERE (content_type = 200 AND reply_time IS NULL);

selectMessageById:
SELECT message.*, url_metadata.json_data, message_data.data_id ,message_data.file_path,message_data.creation_time,message_data.data_type
FROM message
LEFT JOIN url_metadata ON message.id = url_metadata.message_id
LEFT JOIN message_data ON message.id = message_data.message_id
WHERE message.id = ?;


selectMessageByTaskId:
SELECT message.*, url_metadata.json_data, message_data.data_id ,message_data.file_path,message_data.creation_time,message_data.data_type
FROM message
LEFT JOIN url_metadata ON message.id = url_metadata.message_id
LEFT JOIN message_data ON message.id = message_data.message_id
WHERE task_id = ?
ORDER BY datetime(create_time) DESC;

selectTaskMessagesByContentType:
SELECT message.*, url_metadata.json_data, message_data.data_id ,message_data.file_path,message_data.creation_time,message_data.data_type
FROM message
LEFT JOIN url_metadata ON message.id = url_metadata.message_id
LEFT JOIN message_data ON message.id = message_data.message_id
WHERE message.task_id = ? AND message.content_type = ?
ORDER BY datetime(message.create_time) DESC;

selectMessageFromTask:
SELECT message.*
FROM message
WHERE message.content_type = ?
ORDER BY datetime(create_time) DESC;

selectTaskMessage:
SELECT message.id, url_metadata.json_data
FROM message
LEFT JOIN url_metadata ON message.id = url_metadata.message_id
WHERE task_id = ? AND content_type = ?
ORDER BY id DESC LIMIT 1;

insertMessage:
INSERT INTO message(task_id, schedule_id, create_time, content_type, content)
VALUES (?,?,?,?,?);

updateTaskMessageReply:
UPDATE message
SET reply_type = ?, reply_content = ?, reply_time = ?
WHERE id = ?;

deleteActiveReminderMessages:
DELETE FROM message
WHERE content_type = 200 AND reply_time IS NULL;

countMessages:
SELECT count(*) FROM message;

countActiveReminderMessages:
SELECT count(*) FROM message
WHERE content_type = 200 AND reply_time IS NULL;

pageMessages:
SELECT *
FROM message
ORDER BY id DESC
LIMIT :limit OFFSET :offset;

lastInsertRowId:
SELECT last_insert_rowid();

deleteMessage:
DELETE FROM message
WHERE id = ?;




