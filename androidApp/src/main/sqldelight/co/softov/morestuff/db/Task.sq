import co.softov.morestuff.android.domain.enums.TaskType;

CREATE TABLE task(
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    uuid TEXT NOT NULL,
    create_time TEXT NOT NULL,
    complete_time TEXT,
    title TEXT NOT NULL,
    priority_score INTEGER NOT NULL,
    task_type TEXT AS TaskType NOT NULL
    );

selectAll:
SELECT *
FROM task
ORDER BY datetime(create_time);

selectAllActive:
SELECT
    task.*,
    schedule.id AS schedule_id,
    schedule.task_id AS schedule_task_id,
    schedule.active AS schedule_active,
    schedule.create_time AS schedule_create_time,
    schedule.timezone AS schedule_timezone,
    schedule.schedule_time_utc,
    schedule.schedule_time_local,
    schedule.schedule_type
FROM task
LEFT JOIN schedule ON task.id = schedule.task_id AND schedule.active = 1
WHERE task.complete_time IS NULL
ORDER BY task.priority_score DESC;

selectActiveTasksWithSchedule:
SELECT
    task.*,
    schedule.id AS schedule_id,
    schedule.task_id AS schedule_task_id,
    schedule.active AS schedule_active,
    schedule.create_time AS schedule_create_time,
    schedule.timezone AS schedule_timezone,
    schedule.schedule_time_utc,
    schedule.schedule_time_local,
    schedule.schedule_type
FROM task
INNER JOIN schedule ON task.id = schedule.task_id AND schedule.active = 1
WHERE task.complete_time IS NULL AND schedule_type IN :schedule_type;

getActiveTaskWhithoutSchedule:
SELECT *
FROM task
WHERE complete_time IS NULL AND id NOT IN (
    SELECT task_id
    FROM schedule
    WHERE active = 1 AND schedule_type = 'OneTime'
);

selectAllComplete:
SELECT *
FROM task
WHERE complete_time IS NOT NULL
ORDER BY task.complete_time DESC;

selectHighestPriorityScore:
SELECT max(priority_score) FROM task;

selectLowestPriorityScore:
SELECT min(priority_score) FROM task;

selectHighestPriorityTasks:
SELECT *
FROM task
WHERE priority_score > 0 AND complete_time IS NULL
ORDER BY priority_score DESC;

selectLowestPriorityTasks:
SELECT *
FROM task
WHERE priority_score < 0 AND complete_time IS NULL
ORDER BY priority_score DESC;

selectTaskById:
SELECT *
FROM task
WHERE id = ?;

insertTask:
INSERT INTO task (uuid, create_time, complete_time, title, priority_score, task_type)
VALUES ?;

updateTaskComplete:
UPDATE task
SET complete_time = ?
WHERE id = ?;

updateTaskTitle:
UPDATE task
SET title = ?
WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();

updateTaskPriorityScore:
UPDATE task
SET priority_score = :priority_score
WHERE id = :task_id;

decrementTaskPriorityScore:
UPDATE task
SET priority_score = priority_score - 1
WHERE priority_score <= :priority_score;

incrementTaskPriorityScore:
UPDATE task
SET priority_score = priority_score + 1
WHERE priority_score >= :priority_score;
