import co.softov.morestuff.android.domain.enums.TaskType;

CREATE TABLE task(
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    uuid TEXT NOT NULL,
    create_time TEXT NOT NULL,
    complete_time TEXT,
    title TEXT NOT NULL,
    priority_score INTEGER NOT NULL,
    task_type TEXT AS TaskType NOT NULL
    );

selectAll:
SELECT *
FROM task
ORDER BY datetime(create_time);

selectAllActive:
SELECT *
FROM task
WHERE complete_time IS NULL;

selectAllComplete:
SELECT *
FROM task
WHERE complete_time IS NOT NULL
ORDER BY task.complete_time DESC;

selectTaskById:
SELECT *
FROM task
WHERE id = ?;

insertTask:
INSERT INTO task
VALUES ?;

updateTaskComplete:
UPDATE task
SET complete_time = ?
WHERE id = ?;

updateTaskTitle:
UPDATE task
SET title = ?
WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();