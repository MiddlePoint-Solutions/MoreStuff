import co.softov.morestuff.android.domain.enums.TaskType;

CREATE TABLE task(
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    uuid TEXT NOT NULL,
    create_time TEXT NOT NULL,
    complete_time TEXT,
    title TEXT NOT NULL,
    priority_score INTEGER NOT NULL,
    task_type TEXT AS TaskType NOT NULL
    );

selectAll:
SELECT *
FROM task
ORDER BY datetime(create_time);

selectAllActive:
SELECT *
FROM task
WHERE complete_time IS NULL
ORDER BY priority_score DESC, datetime(create_time) DESC;

selectAllComplete:
SELECT *
FROM task
WHERE complete_time IS NOT NULL
ORDER BY task.complete_time DESC;

selectHighestPriorityScore:
SELECT max(priority_score) FROM task;

selectLowestPriorityScore:
SELECT min(priority_score) FROM task;

selectTaskById:
SELECT *
FROM task
WHERE id = ?;

insertTask:
INSERT INTO task (uuid, create_time, complete_time, title, priority_score, task_type)
VALUES ?;

updateTaskComplete:
UPDATE task
SET complete_time = ?
WHERE id = ?;

updateTaskTitle:
UPDATE task
SET title = ?
WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();