CREATE TABLE task(
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    create_time TEXT NOT NULL,
    complete_time TEXT,
    title TEXT NOT NULL
    );

selectAll:
SELECT *
FROM task
ORDER BY datetime(create_time);

selectAllActive:
SELECT *
FROM task
WHERE complete_time IS NULL;

selectAllComplete:
SELECT *
FROM task
WHERE complete_time IS NOT NULL
ORDER BY task.complete_time DESC;

selectTaskById:
SELECT *
FROM task
WHERE id = ?;

insertTask:
INSERT INTO task(create_time, title)
VALUES (?,?);

updateTaskComplete:
UPDATE task
SET complete_time = ?
WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();