CREATE TABLE url_metadata (
    url TEXT NOT NULL,
    json_data TEXT NOT NULL,
    message_id INTEGER,
    PRIMARY KEY(url, message_id),
    FOREIGN KEY(message_id) REFERENCES message(id)
);


insertUrlMetadata:
INSERT INTO url_metadata(url, json_data, message_id)
VALUES (?, ?, ?);

getUrlMetadata:
SELECT *
FROM url_metadata
WHERE message_id = ?;