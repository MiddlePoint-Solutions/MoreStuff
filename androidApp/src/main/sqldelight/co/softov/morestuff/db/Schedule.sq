import co.softov.morestuff.androidApp.domain.enums.Message;

CREATE TABLE schedule(
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    task_id INTEGER NOT NULL,
    create_time INTEGER NOT NULL,
    schedule_time INTEGER NOT NULL DEFAULT 0,
    type TEXT AS Message NOT NULL,
    fulfilled INTEGER AS Boolean NOT NULL DEFAULT 0,
    FOREIGN KEY(task_id) REFERENCES task(id)
    );

selectAll:
SELECT *
FROM schedule
ORDER BY datetime(create_time);

selectScheduleById:
SELECT *
FROM schedule
WHERE id = ?;

selectSchedulesByTaskId:
SELECT *
FROM schedule
WHERE task_id = ?;

selectActiveScheduleByTaskId:
SELECT *
FROM schedule
WHERE task_id = ?
AND fulfilled = 0
ORDER BY id DESC
LIMIT 1;

selectActiveSchedules:
SELECT *
FROM schedule
WHERE fulfilled = 0;

selectActiveSchedulesWithTaskTitle:
SELECT schedule.id, schedule.task_id, schedule.schedule_time, task.title
FROM schedule
INNER JOIN task ON (task.id = task_id AND task.complete_time = 0)
AND schedule.fulfilled = 0
ORDER BY schedule_time ASC;

insertSchedule:
INSERT INTO schedule(task_id, create_time, schedule_time, type)
VALUES (?,?,?,?);

updateScheduleFulfilled:
UPDATE schedule
SET fulfilled = ?
WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();