CREATE TABLE scope (
    scope_id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    scope_uid TEXT NOT NULL,
    name TEXT NOT NULL,
    order_index INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE task_scope (
    task_id INTEGER NOT NULL REFERENCES task(id),
    scope_id INTEGER NOT NULL REFERENCES scope(scope_id),
    PRIMARY KEY (task_id, scope_id)
);

